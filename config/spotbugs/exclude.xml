<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

    <!-- Ignorar falsos positivos comunes en Spring Boot -->

    <!-- EI_EXPOSE_REP: ignorado globalmente — DTOs y Responses exponen referencias intencionalmente -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- HE_EQUALS_USE_HASHCODE: Lombok genera ambos, Spotbugs no lo detecta -->
    <Match>
        <Bug pattern="HE_EQUALS_USE_HASHCODE"/>
    </Match>

    <!-- SE_BAD_FIELD: JPA entities no necesitan serialVersionUID -->
    <Match>
        <Bug pattern="SE_BAD_FIELD,SE_NO_SERIALVERSIONID"/>
    </Match>

    <!-- NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE: Falsos positivos con Optional -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
        <Class name="~.*Service"/>
    </Match>

    <!-- XSS_SERVLET: Falso positivo en LoginRateLimitFilter — string generado por servidor, sin datos de usuario -->
    <Match>
        <Bug pattern="XSS_SERVLET"/>
        <Class name="ar.com.lbr.precisionappbe.security.LoginRateLimitFilter"/>
    </Match>

    <!--
        FolderService: Todos los métodos construyen paths desde:
          - directorioRaizCarpetas (configurado por admin, leído de DB)
          - sanitizeFolderName(nombreCliente) — elimina chars especiales de FS
          - idPresupuesto / idTrabajo (Integer, safe)
        abrirCarpeta además verifica contención canónica antes de cualquier operación.
        Falsos positivos: SpotBugs trata DB-sourced config y sanitized strings como tainted.
    -->
    <Match>
        <Bug pattern="COMMAND_INJECTION,PATH_TRAVERSAL,PATH_TRAVERSAL_IN,TAINTED_PATH,RV_RETURN_VALUE_IGNORED_BAD_PRACTICE"/>
        <Class name="ar.com.lbr.precisionappbe.services.FolderService"/>
    </Match>

    <!--
        PATH_TRAVERSAL: UtilsController.browseDirectories valida que el path solicitado esté dentro del
        directorio raiz configurado (canonicalRoot) antes de listar. Falso positivo de SpotBugs.
    -->
    <Match>
        <Bug pattern="PATH_TRAVERSAL,PATH_TRAVERSAL_IN,TAINTED_PATH"/>
        <Class name="ar.com.lbr.precisionappbe.controller.UtilsController"/>
        <Method name="browseDirectories"/>
    </Match>

</FindBugsFilter>
