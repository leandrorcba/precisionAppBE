# ==============================================================================
# PrecisionApp - Archivo de Variables de Entorno de Ejemplo (.env.example)
# Copie este archivo como '.env' y complete con sus credenciales reales.
# NUNCA suba el archivo '.env' a repositorios de control de versiones.
# ==============================================================================

# Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=precision_v2
DB_USER=root
DB_PASSWORD=TU_PASSWORD_MYSQL_AQUI

# Seguridad y Autenticación JWT (Clave Base64 HMAC de al menos 256 bits)
JWT_SECRET=TU_JWT_SECRET_BASE64_AQUI_MINIMO_256_BITS

# Contraseña Inicial del Super Administrador ('leandror')
SUPER_ADMIN_PASSWORD=TU_PASSWORD_SUPER_ADMIN_AQUI

# Configuración de Red y CORS
CORS_ALLOWED_ORIGINS=https://precision.lbrebolini.net,http://localhost:10081,http://localhost
SERVER_PORT=10080
